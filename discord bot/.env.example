# VEGA CrimeLife Discord Bot - Konfiguration

# Discord Bot Zugangsdaten (Erstelle einen Bot unter https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
# Optional: Guild ID für sofortiges Laden der Slash-Commands auf einem bestimmten Server (ohne Guild ID: global, dauert bis zu 1 Std.)
GUILD_ID=

# FiveM Server Konfiguration
FIVEM_IP=play.vega-crimelife.de
FIVEM_PORT=30120

# Forum API Konfiguration (Lokal oder Domain)
FORUM_API_URL=http://localhost:3000
FORUM_API_KEY=
